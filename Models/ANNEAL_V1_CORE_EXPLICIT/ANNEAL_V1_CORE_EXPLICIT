    for name, param in model.named_parameters():
        print(name,tuple(param.shape),param.numel())
    trajectories=[]
    for _ in range(15):
        t,synthetic_position=generate_random_trajectory(num_points=50,motion_type="oscillatory",noise=.5)
        trajectories.append((t,synthetic_position))
    train_on_synthetic(model,trajectories,lr= 1e-2,epochs=125)
    pos_super,imag_magnitude,real_magnitude,loss,P_lat_real,P_lat_imag,Theta_lat_real,Theta_lat_imag,delta_update,time_projection_lat,state,branch_variance=evaluate_model(model,synthetic_position)
    visualize_trajectory(pos_super,imag_magnitude,real_magnitude,synthetic_position,loss=loss.item(),title="Synthetic Trajectory Example")
